<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="kaizen-map" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_1" name="Customer quote (current state)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_0" name="Customer">
        <bpmn:flowNodeRef>start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>askcust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>end</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_1" name="Sales">
        <bpmn:flowNodeRef>read</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>approve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_2" name="Engineering">
        <bpmn:flowNodeRef>spec</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_3" name="Manager">
        <bpmn:flowNodeRef>mgr</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="start" name="Quote request by email">
      <bpmn:outgoing>Flow_start_read</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="read" name="Read email, copy details into CRM">
      <bpmn:documentation>Waste: Transport: re-keying from email to CRM</bpmn:documentation>
      <bpmn:incoming>Flow_start_read</bpmn:incoming>
      <bpmn:incoming>Flow_askcust_read</bpmn:incoming>
      <bpmn:outgoing>Flow_read_complete</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="complete" name="Information complete?">
      <bpmn:incoming>Flow_read_complete</bpmn:incoming>
      <bpmn:outgoing>Flow_complete_spec</bpmn:outgoing>
      <bpmn:outgoing>Flow_complete_askcust</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="askcust" name="Send missing info">
      <bpmn:documentation>Waste: Defects: 40% of requests come back incomplete</bpmn:documentation>
      <bpmn:incoming>Flow_complete_askcust</bpmn:incoming>
      <bpmn:outgoing>Flow_askcust_read</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="spec" name="Estimate technical cost">
      <bpmn:documentation>Waste: Waiting: 3 days in engineering queue</bpmn:documentation>
      <bpmn:incoming>Flow_complete_spec</bpmn:incoming>
      <bpmn:outgoing>Flow_spec_price</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="price" name="Build quote in spreadsheet">
      <bpmn:incoming>Flow_spec_price</bpmn:incoming>
      <bpmn:outgoing>Flow_price_approve</bpmn:outgoing>
    </bpmn:task>
    <bpmn:exclusiveGateway id="approve" name="Discount over 10%?">
      <bpmn:incoming>Flow_price_approve</bpmn:incoming>
      <bpmn:outgoing>Flow_approve_mgr</bpmn:outgoing>
      <bpmn:outgoing>Flow_approve_send</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="mgr" name="Approve discount">
      <bpmn:documentation>Waste: Waiting: approvals done once a week</bpmn:documentation>
      <bpmn:incoming>Flow_approve_mgr</bpmn:incoming>
      <bpmn:outgoing>Flow_mgr_send</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="send" name="Send quote PDF">
      <bpmn:incoming>Flow_approve_send</bpmn:incoming>
      <bpmn:incoming>Flow_mgr_send</bpmn:incoming>
      <bpmn:outgoing>Flow_send_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="end" name="Quote received">
      <bpmn:incoming>Flow_send_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_read" name="" sourceRef="start" targetRef="read" />
    <bpmn:sequenceFlow id="Flow_read_complete" name="" sourceRef="read" targetRef="complete" />
    <bpmn:sequenceFlow id="Flow_complete_spec" name="yes" sourceRef="complete" targetRef="spec" />
    <bpmn:sequenceFlow id="Flow_complete_askcust" name="no" sourceRef="complete" targetRef="askcust" />
    <bpmn:sequenceFlow id="Flow_askcust_read" name="" sourceRef="askcust" targetRef="read" />
    <bpmn:sequenceFlow id="Flow_spec_price" name="" sourceRef="spec" targetRef="price" />
    <bpmn:sequenceFlow id="Flow_price_approve" name="" sourceRef="price" targetRef="approve" />
    <bpmn:sequenceFlow id="Flow_approve_mgr" name="yes" sourceRef="approve" targetRef="mgr" />
    <bpmn:sequenceFlow id="Flow_approve_send" name="no" sourceRef="approve" targetRef="send" />
    <bpmn:sequenceFlow id="Flow_mgr_send" name="" sourceRef="mgr" targetRef="send" />
    <bpmn:sequenceFlow id="Flow_send_end" name="" sourceRef="send" targetRef="end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Pool_1_di" bpmnElement="Pool_1" isHorizontal="true"><dc:Bounds x="40" y="40" width="1580" height="520" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_0_di" bpmnElement="Lane_0" isHorizontal="true"><dc:Bounds x="70" y="40" width="1550" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_1_di" bpmnElement="Lane_1" isHorizontal="true"><dc:Bounds x="70" y="170" width="1550" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_2_di" bpmnElement="Lane_2" isHorizontal="true"><dc:Bounds x="70" y="300" width="1550" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_3_di" bpmnElement="Lane_3" isHorizontal="true"><dc:Bounds x="70" y="430" width="1550" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="177" y="87" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="read_di" bpmnElement="read"><dc:Bounds x="300" y="200" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="complete_di" bpmnElement="complete" isMarkerVisible="true"><dc:Bounds x="490" y="210" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="askcust_di" bpmnElement="askcust"><dc:Bounds x="620" y="70" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="spec_di" bpmnElement="spec"><dc:Bounds x="620" y="330" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="price_di" bpmnElement="price"><dc:Bounds x="780" y="200" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="approve_di" bpmnElement="approve" isMarkerVisible="true"><dc:Bounds x="970" y="210" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="mgr_di" bpmnElement="mgr"><dc:Bounds x="1100" y="460" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="send_di" bpmnElement="send"><dc:Bounds x="1260" y="200" width="110" height="70" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end_di" bpmnElement="end"><dc:Bounds x="1457" y="87" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_read_di" bpmnElement="Flow_start_read"><di:waypoint x="213" y="105" /><di:waypoint x="256" y="105" /><di:waypoint x="256" y="235" /><di:waypoint x="300" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_read_complete_di" bpmnElement="Flow_read_complete"><di:waypoint x="410" y="235" /><di:waypoint x="490" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_complete_spec_di" bpmnElement="Flow_complete_spec"><di:waypoint x="515" y="260" /><di:waypoint x="515" y="365" /><di:waypoint x="620" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_complete_askcust_di" bpmnElement="Flow_complete_askcust"><di:waypoint x="515" y="210" /><di:waypoint x="515" y="105" /><di:waypoint x="620" y="105" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_askcust_read_di" bpmnElement="Flow_askcust_read"><di:waypoint x="675" y="140" /><di:waypoint x="675" y="295" /><di:waypoint x="355" y="295" /><di:waypoint x="355" y="270" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_spec_price_di" bpmnElement="Flow_spec_price"><di:waypoint x="730" y="365" /><di:waypoint x="755" y="365" /><di:waypoint x="755" y="235" /><di:waypoint x="780" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_price_approve_di" bpmnElement="Flow_price_approve"><di:waypoint x="890" y="235" /><di:waypoint x="970" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_approve_mgr_di" bpmnElement="Flow_approve_mgr"><di:waypoint x="995" y="260" /><di:waypoint x="995" y="495" /><di:waypoint x="1100" y="495" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_approve_send_di" bpmnElement="Flow_approve_send"><di:waypoint x="1020" y="235" /><di:waypoint x="1260" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_mgr_send_di" bpmnElement="Flow_mgr_send"><di:waypoint x="1210" y="495" /><di:waypoint x="1235" y="495" /><di:waypoint x="1235" y="235" /><di:waypoint x="1260" y="235" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_send_end_di" bpmnElement="Flow_send_end"><di:waypoint x="1370" y="235" /><di:waypoint x="1414" y="235" /><di:waypoint x="1414" y="105" /><di:waypoint x="1457" y="105" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
